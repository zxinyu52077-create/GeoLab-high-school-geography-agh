# GeoLab public template only. Never put a real model key in this file.
# Configure the Agnes provider and model route in the private AGH Web/TUI flow.
# The GeoLab AGH plugin itself does not read or persist provider credentials.
# Local AGH Web bridge (the launcher supplies this default automatically).
GEOLAB_AGH_WEB_URL=http://127.0.0.1:4177
# Optional: an already-registered AGH workspace directory, if it is not under tmp/.
# GEOLAB_AGH_CLI_CWD=C:/path/to/agnes-harness-main
